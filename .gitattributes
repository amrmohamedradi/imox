# Normalize line endings: store as LF in the repo, check out as LF everywhere.
# This resolves the prettier/eslint "Delete `␍`" (CRLF) errors on Windows.
* text=auto eol=lf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg text eol=lf
*.ico binary
*.woff binary
*.woff2 binary
